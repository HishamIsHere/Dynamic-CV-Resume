@* @model IEnumerable<WebAppTemplate.Models.MasterPortfolio> *@
@model WebAppTemplate.ViewModels.MasterPortfolioFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="row justify-content-center">
    <div class="col-sm-6 col-md-4 col-xl-3">
        <div class="col-lg-12 ">
            <div class="card card-body text-center">
                <h4 class="card-title">Record Configuration</h4>
                <p class="card-text">
                    Press the button below to add a record
                </p>
                <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
            </div>
        </div>
    </div>
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" method="post" enctype="multipart/form-data" id="terminalForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ThumbnailImageURL" id="ThumbnailImageURL" />
        <input type="hidden" asp-for="ViewImageURL" id="ViewImageURL" />
        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Title" class="control-label"></label>
                                                        <input asp-for="Title" id="Title" class="form-control" />
                                                        <span asp-validation-for="Title" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="FormModel.CategoryId" class="control-label"></label>
                                                        <select asp-for="FormModel.CategoryId" name="CategoryId" id="CategoryId" asp-items="Model.MasterCategoryList" class="form-control form-select">
                                                            <option value="">-- Select Category --</option>
                                                        </select>
                                                        <span asp-validation-for="FormModel.CategoryId" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group">
                                                        <label asp-for="ThumbnailImageURL" class="control-label"></label>
                                                        <input asp-for="ThumbnailImageFile" id="ThumbnailImageFile" type="file" class="form-control" />
                                                        <span asp-validation-for="ThumbnailImageURL" class="text-danger"></span>
                                                        <div id="imagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-group">
                                                        <label asp-for="ViewImageURL" class="control-label"></label>
                                                        <input asp-for="ViewImageFile" id="ViewImageFile" type="file" class="form-control" />
                                                        <span asp-validation-for="ViewImageURL" class="text-danger"></span>
                                                        <div id="cvPreview" class="mt-2"></div>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <div class="form-check">
                                                            <input class="form-check-input" asp-for="IsActive" id="IsActive" />
                                                            <label class="form-check-label" for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btnClose btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>



<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FormModel.Title)
            </th>
            <th>
                <div class="value=" Category Id"">@Html.DisplayNameFor(model => model.FormModel.MasterCategory)</div>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FormModel.ThumbnailImageURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FormModel.ViewImageURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FormModel.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.List) {
        <tr>
            <td>
                @item.Title
            </td>
                <td>
                    @item.MasterCategory
                </td>
                <td>
                    @item.ThumbnailImageURL
                </td>
                <td>
                    @item.ViewImageURL
                </td>
                <td>
                    @item.IsActive
                </td>
            <td>
                    <a class="btn btn-light btn-rounded waves-effect btnEdit" data-categoryid="@item.CategoryId" data-title="@item.Title" data-thumbnailimageurl="@item.ThumbnailImageURL" data-viewimageurl="@item.ViewImageURL" data-isactive="@item.IsActive"
                       data-bs-toggle="modal"
                       data-bs-target=".bs-example-modal-xl">Edit</a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                        <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                    </form>
            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){

        var Id = $(this).data('id');
        var CategoryId = $(this).data('categoryid');
        var ThumbnailImageURL = $(this).data('thumbnailimageurl');
        var ViewImageURL = $(this).data('viewimageurl');
        var Title = $(this).data('title');
        var IsActive = $(this).data('isactive');

        $("#Id").val(Id);
        $("#CategoryId").val(CategoryId);
        $("#ThumbnailImageURL").val(ThumbnailImageURL);
        $("#ViewImageURL").val(ViewImageURL);
        $("#Title").val(Title);
        $("#IsActive").prop('checked', IsActive === true || IsActive === 'True' || IsActive === 'true');

        $("#ThumnailImageURL").val(ThumbnailImageURL);
        $("#ViewImageURL").val(ViewImageURL);
        $("#ThumbnailImageFile").val('');
        $("#ViewImageFile").val('');

        if (ThumbnailImageURL) {
        $("#imagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="${ThumbnailImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#imagePreview").empty();
        }

        if (ViewImageURL) {
        $("#cvPreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="${ViewImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#cvPreview").empty();
        }

        });

        $('#btnClear').click(function() {
        $("#imagePreview").empty();
        $("#cvPreview").empty();
        $("#ThumbnailImageURL").val('');
        $("#ViewImageURL").val('');
        });

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        $("#imagePreview").empty();
        $("#cvPreview").empty();
        $("#ThumbnailImageURL").val('');
        $("#ViewImageURL").val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();



        });
        })
        })
    </script>
}