@* @model IEnumerable<WebAppTemplate.ViewModels.MasterAboutViewModel> *@
@model WebAppTemplate.ViewModels.MasterAboutFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>About</h1>

<div class="row justify-content-center">
    @if (Model == null)
    {
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="col-lg-12 ">
                <div class="card card-body text-center">
                    <h4 class="card-title">Record Configuration</h4>
                    <p class="card-text">
                        Press the button below to add a record
                    </p>
                    <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
                </div>
            </div>
        </div>
    }
    
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" method="post" id="terminalForm" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
        <input type="hidden" asp-for="Id" id="Id" />
        <input type="hidden" asp-for="ImageURL" id="ImageURL" />
        <input type="hidden" asp-for="CVURL" id="CVURL" />

        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Name" class="control-label"></label>
                                                        <input asp-for="Name" id="Name" class="form-control" />
                                                        <span asp-validation-for="Name" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="ImageURL" class="control-label"></label>
                                                        <input asp-for="Imagefile" id="Imagefile" type="file" class="form-control" />
                                                        <span asp-validation-for="ImageURL" class="text-danger"></span>
                                                        <div id="imagePreview" class="mt-2"></div>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="CVURL" class="control-label"></label>
                                                        <input asp-for="CVFile" id="CVFile" type="file" class="form-control" />
                                                        <span asp-validation-for="CVURL" class="text-danger"></span>
                                                        <div id="cvPreview" class="mt-2"></div>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Desc" class="control-label"></label>
                                                        <input asp-for="Desc" id="Desc" class="form-control" />
                                                        <span asp-validation-for="Desc" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="DateOfBirth" class="control-label"></label>
                                                        <input asp-for="DateOfBirth" id="DateOfBirth" class="form-control" />
                                                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Country" class="control-label"></label>
                                                        <input asp-for="Country" id="Country" class="form-control" />
                                                        <span asp-validation-for="Country" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Address" class="control-label"></label>
                                                        <input asp-for="Address" id="Address" class="form-control" />
                                                        <span asp-validation-for="Address" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Email" class="control-label"></label>
                                                        <input asp-for="Email" id="Email" class="form-control" />
                                                        <span asp-validation-for="Email" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <label asp-for="Phone" class="control-label"></label>
                                                        <input asp-for="Phone" id="Phone" class="form-control" />
                                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                                    </div>

                                                    <div class="mb-4 form-group">
                                                        <div class="form-check">
                                                            <input class="form-check-input" asp-for="IsActive" id="IsActive" />
                                                            <label class="form-check-label" for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CVURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Desc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
            @foreach(var item in Model.List) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ImageURL)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CVURL)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Desc)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DateOfBirth)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Country)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Address)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>
                    <td>
                        <a class="btn btn-light btn-rounded waves-effect btnEdit" data-id="@item.Id" data-address="@item.Address" data-age="@item.Age" data-country="@item.Country" data-isactive="@item.IsActive"
                           data-imgurl="@item.ImageURL" data-cvurl="@item.CVURL" data-dob="@item.DateOfBirth" data-desc="@item.Desc" data-email="@item.Email" data-phone="@item.Phone" data-name="@item.Name"
                       data-bs-toggle="modal"
                       data-bs-target=".bs-example-modal-xl">Edit</a>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                            <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                        </form>
                    </td>
                </tr>
            }
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){

        var Id = $(this).data('id');
        var Name = $(this).data('name');
        var ImageURL = $(this).data('imgurl');
        var CVURL = $(this).data('cvurl');
        var Desc = $(this).data('desc');
        var Country = $(this).data('country');
        var Address = $(this).data('address');
        var Email = $(this).data('email');
        var Phone = $(this).data('phone');
        var IsActive = $(this).data('isactive');
        var DateOfBirth = $(this).data('dob');

        $("#Id").val(Id);
        $("#Name").val(Name);
        $("#Desc").val(Desc);
        $("#Country").val(Country);
        $("#Address").val(Address);
        $("#Email").val(Email);
        $("#Phone").val(Phone);
        $("#IsActive").prop('checked', IsActive === true || IsActive === 'True' || IsActive === 'true');

        $("#ImageURL").val(ImageURL);
        $("#CVURL").val(CVURL);
        $("#Imagefile").val('');
        $("#CVFile").val('');

        if (ImageURL) {
        $("#imagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="${ImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#imagePreview").empty();
        }

        if (CVURL) {
        $("#cvPreview").html(`
        <small class="text-muted d-block">Current CV:</small>
        <a href="${CVURL}" target="_blank" class="btn btn-sm btn-outline-info mt-1">View File</a>
        `);
        } else {
        $("#cvPreview").empty();
        }

        if (DateOfBirth) {
        try {
        var parsedDate = new Date(DateOfBirth);
        if (!isNaN(parsedDate.getTime())) {
        var localISOTime = parsedDate.toISOString().slice(0, 16);
        $("#DateOfBirth").val(localISOTime);
        }
        } catch (e) {
        console.warn("Could not parse date:", DateOfBirth);
        }
        }
        });

        $('#btnClear').click(function() {
        $("#imagePreview").empty();
        $("#cvPreview").empty();
        $("#ImageURL").val('');
        $("#CVURL").val('');
        });

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        $("#imagePreview").empty();
        $("#cvPreview").empty();
        $("#ImageURL").val('');
        $("#CVURL").val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();



        });
        })
        })
    </script>
}