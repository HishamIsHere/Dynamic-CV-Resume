@* @model IEnumerable<WebAppTemplate.ViewModels.MasterPositionsViewModel> *@
@model WebAppTemplate.ViewModels.MasterPositionsFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>Positions</h1>

<div class="row justify-content-center">
    <div class="col-sm-6 col-md-4 col-xl-3">
        <div class="col-lg-12 ">
            <div class="card card-body text-center">
                <h4 class="card-title">Record Configuration</h4>
                <p class="card-text">
                    Press the button below to add a record
                </p>
                <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
            </div>
        </div>
    </div>
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" id="terminalForm" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group .form-control-lg">
                                                        <label asp-for="Name" class="control-label"></label>
                                                        <input asp-for="Name" class="form-control" />
                                                        <span asp-validation-for="Name" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group">
                                                        <div class="form-group form-check">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input is-primary-input" asp-for="IsPrimary" /> @Html.DisplayNameFor(model => model.IsPrimary)
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="mb-4 form-group">
                                                        <div class="form-group form-check">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input is-active-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="mb-4 form-group">
                                                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                                                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPrimary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.List)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsPrimary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    <a class="btn btn-light btn-rounded waves-effect btnEdit" data-id="@item.Id" data-name="@item.Name" data-isprimary="@item.IsPrimary.ToString().ToLower()" data-isactive="@item.IsActive.ToString().ToLower()"
                       data-bs-toggle="modal"
                       data-bs-target=".bs-example-modal-xl">Edit</a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                        <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){
        var Id = $(this).data('id')
        var Name = $(this).data('name')
        var IsPrimary = $(this).data('isprimary') === true || $(this).data('isprimary') === "true";
        var IsActive = $(this).data('isactive') === true || $(this).data('isactive') === "true";
        $("#Id").val(Id);
        $("#Name").val(Name);
        
        $("#IsPrimary").prop('checked', IsPrimary);
        $("#IsActive").prop('checked', IsActive);
        })

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();
        });
        })


        })
    </script>
}
