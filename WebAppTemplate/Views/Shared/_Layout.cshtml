<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>BreezyCV - Resume / CV / vCard Template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="BreezyCV - Resume / CV / vCard Template" />
    <meta name="keywords" content="vcard, resposnive, retina, resume, jquery, css3, bootstrap, Material CV, portfolio" />
    <meta name="author" content="lmpixels" />
    <link rel="shortcut icon" href="favicon.ico">


    <link rel="stylesheet" href="~/ClientTemplate/css/reset.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/bootstrap-grid.min.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/animations.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/perfect-scrollbar.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/owl.carousel.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="~/ClientTemplate/css/main.css" type="text/css">

    <script src="js/modernizr.custom.js"></script>
</head>

<body>
    <!-- Animated Background -->
    <div class="lm-animated-bg" style="background-image: url(/ClientTemplate/img/main_bg.png);"></div>
    <!-- /Animated Background -->
    <!-- Loading animation -->
    <div class="preloader">
        <div class="preloader-animation">
            <div class="preloader-spinner">
            </div>
        </div>
    </div>
    <!-- /Loading animation -->

    @RenderBody()

<script src="~/ClientTemplate/js/jquery-2.1.3.min.js"></script>
<script src="~/ClientTemplate/js/modernizr.custom.js"></script>
<script src="~/ClientTemplate/js/animating.js"></script>
<script src="~/ClientTemplate/js/imagesloaded.pkgd.min.js"></script>
<script src='~/ClientTemplate/js/perfect-scrollbar.min.js'></script>
<script src='~/ClientTemplate/js/jquery.shuffle.min.js'></script>
<script src='~/ClientTemplate/js/masonry.pkgd.min.js'></script>
<script src='~/ClientTemplate/js/owl.carousel.min.js'></script>
<script src="~/ClientTemplate/js/jquery.magnific-popup.min.js"></script>
<script src="~/ClientTemplate/js/validator.js"></script>
<script src="~/ClientTemplate/js/main.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
