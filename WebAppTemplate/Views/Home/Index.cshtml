@using WebAppTemplate.ViewModels
@{
    ViewData["Title"] = "Home Page";
}
@model HomeViewModel

<div class="page">
    <div class="page-content">

        <header id="site_header" class="header mobile-menu-hide">
            <div class="header-content">
                <div class="header-photo">
                    <img src="@Model.MasterAbout.ImageURL" alt="@Model.MasterAbout.Name">
                </div>
                <div class="header-titles">
                    <h2>@Model.MasterAbout.Name</h2>
                    <h4>@Model.MasterPositions.FirstOrDefault(x=>x.IsPrimary)?.Name</h4>
                </div>
            </div>

            <ul class="main-menu">
                <li class="active">
                    <a href="#home" class="nav-anim">
                        <span class="menu-icon lnr lnr-home"></span>
                        <span class="link-text">Home</span>
                    </a>
                </li>
                <li>
                    <a href="#about-me" class="nav-anim">
                        <span class="menu-icon lnr lnr-user"></span>
                        <span class="link-text">About Me</span>
                    </a>
                </li>
                <li>
                    <a href="#resume" class="nav-anim">
                        <span class="menu-icon lnr lnr-graduation-hat"></span>
                        <span class="link-text">Resume</span>
                    </a>
                </li>
                <li>
                    <a href="#portfolio" class="nav-anim">
                        <span class="menu-icon lnr lnr-briefcase"></span>
                        <span class="link-text">Portfolio</span>
                    </a>
                </li>
                <li>
                    <a href="#contact" class="nav-anim">
                        <span class="menu-icon lnr lnr-envelope"></span>
                        <span class="link-text">Contact</span>
                    </a>
                </li>
            </ul>

            <div class="social-links">
                <ul>
                    @foreach(var item in Model.MasterSocialMedia)
                    {
                        <li><a href="@item.Link" target="_blank"><i class="@item.Icon"></i></a></li>
                    }
                    @* <li><a href="#" target="_blank"><i class="fab fa-facebook-f"></i></a></li>
                    <li><a href="#" target="_blank"><i class="fab fa-twitter"></i></a></li> *@
                </ul>
            </div>

            <div class="header-buttons">
                <a href="@Model.MasterAbout.CVURL" download="CV" target="_blank" class="btn btn-primary">Download CV</a>
            </div>

            <div class="copyrights">© 2020 All rights reserved.</div>
        </header>

        <!-- Mobile Navigation -->
        <div class="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <!-- End Mobile Navigation -->
        <!-- Arrows Nav -->
        <div class="lmpixels-arrows-nav">
            <div class="lmpixels-arrow-right"><i class="lnr lnr-chevron-right"></i></div>
            <div class="lmpixels-arrow-left"><i class="lnr lnr-chevron-left"></i></div>
        </div>
        <!-- End Arrows Nav -->

        <div class="content-area">
            <div class="animated-sections">
                <!-- Home Subpage -->
                <section data-id="home" class="animated-section start-page">
                    <div class="section-content vcentered">

                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12">
                                <div class="title-block">
                                    <h2>@Model.MasterAbout.Name</h2>
                                    <div class="owl-carousel text-rotation">
                                        @foreach(var item in Model.MasterPositions)
                                        {
                                            <div class="item">
                                                <div class="sp-subtitle">@item.Name</div>
                                            </div>
                                        }
                            
                                        @* <div class="item">
                                            <div class="sp-subtitle">Frontend-developer</div>
                                        </div> *@
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>
                <!-- End of Home Subpage -->
                <!-- About Me Subpage -->
                <section data-id="about-me" class="animated-section">
                    <div class="page-title">
                        @* <h2>About <span>Me</span></h2> *@
                        @Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "AboutMe2")?.Title)
                    </div>

                    <div class="section-content">
                        <!-- Personal Information -->
                        <div class="row">
                            <div class="col-xs-12 col-sm-7">
                                <p>@Model.MasterAbout.Desc</p>
                            </div>

                            <div class="col-xs-12 col-sm-5">
                                <div class="info-list">
                                    <ul>
                                        <li>
                                            <span class="title">Age</span>
                                            <span class="value">@Model.MasterAbout.Age</span>
                                        </li>

                                        <li>
                                            <span class="title">Residence</span>
                                            <span class="value">@Model.MasterAbout.Country</span>
                                        </li>

                                        <li>
                                            <span class="title">Address</span>
                                            <span class="value">@Model.MasterAbout.Address</span>
                                        </li>

                                        <li>
                                            <span class="title">e-mail</span>
                                            <span class="value">@Model.MasterAbout.Email</span>
                                        </li>

                                        <li>
                                            <span class="title">Phone</span>
                                            <span class="value">@Model.MasterAbout.Phone</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <!-- End of Personal Information -->

                        <div class="white-space-50"></div>

                        <!-- Services -->
                        <div class="row">
                            <div class="col-xs-12 col-sm-12">
                                <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "WhatIDo")?.Title)</h3>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            @foreach (var item in Model.MasterServices)
                            {
                                <div class="col-xs-12 col-sm-6">
                                    <div class="col-inner">
                                        <div class="info-list-w-icon">
                                            <div class="info-block-w-icon">
                                                <div class="ci-icon">
                                                    <i class="@item.Icon"></i>
                                                </div>
                                                <div class="ci-text">
                                                    <h4>@item.Name</h4>
                                                    <p>@item.Desc</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                <!-- End of Services -->

                <div class="white-space-30"></div>

                <!-- Testimonials -->
                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Testimonial")?.Title)</h3>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="testimonials owl-carousel">
                                    @foreach (var item in Model.MasterTestimonials)
                                    {
                                        <!-- Testimonial 1 -->
                                        <div class="testimonial">
                                            <div class="img">
                                                <img src="@item.ImageURL" alt="@item.Name">
                                            </div>
                                            <div class="text">
                                                <p>@item.Desc</p>
                                            </div>

                                            <div class="author-info">
                                                <h4 class="author">@item.Name</h4>
                                                <h5 class="company">@item.Title</h5>
                                                <div class="icon">
                                                    <i class="fas fa-quote-right"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- End of Testimonial 1 -->
                                    }
 

                            <!-- Testimonial 2 -->
                            @* <div class="testimonial">
                                <div class="img">
                                    <img src="~/ClientTemplate/img/testimonials/testimonial-2.jpg" alt="Alex Smith">
                                </div>
                                <div class="text">
                                    <p>Vivamus at molestie dui, eu ornare orci. Curabitur vel egestas dolor. Nulla condimentum nunc sit amet urna tempus finibus. Duis mollis leo id ligula pellentesque, at vehicula dui ultrices.</p>
                                </div>

                                <div class="author-info">
                                    <h4 class="author">Robert Watkins</h4>
                                    <h5 class="company">Endicott Shoes</h5>
                                    <div class="icon">
                                        <i class="fas fa-quote-right"></i>
                                    </div>
                                </div>
                            </div> *@
                            <!-- End of Testimonial 2 -->
                            <!-- Testimonial 3 -->
                            @* <div class="testimonial">
                                <div class="img">
                                    <img src="~/ClientTemplate/img/testimonials/testimonial-3.jpg" alt="Alex Smith">
                                </div>
                                <div class="text">
                                    <p>Vivamus at molestie dui, eu ornare orci. Curabitur vel egestas dolor. Nulla condimentum nunc sit amet urna tempus finibus. Duis mollis leo id ligula pellentesque, at vehicula dui ultrices.</p>
                                </div>

                                <div class="author-info">
                                    <h4 class="author">Kristin Carroll</h4>
                                    <h5 class="company">Helping Hand</h5>
                                    <div class="icon">
                                        <i class="fas fa-quote-right"></i>
                                    </div>
                                </div>
                            </div> *@
                            <!-- End of Testimonial 3 -->
                        </div>
                    </div>
                </div>
                <!-- End of Testimonials -->

                <div class="white-space-50"></div>

                <!-- Clients -->
                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Clients")?.Title)</h3>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="clients owl-carousel">
                                        @foreach (var item in Model.MasterClients)
                                        {
                                            <div class="client-block">
                                                <a href="#" target="_blank" title="Logo">
                                                    <img src="@item.ImageURL" alt="@item.Alt">
                                                </a>
                                            </div>
                                        }
                                    

                        </div>
                    </div>
                </div>
                <!-- End of Clients -->

                <div class="white-space-50"></div>

                <!-- Pricing -->
                <div class="row">
                    <div class="col-xs-12 col-sm-12">

                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Pricing")?.Title)</h3>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class=" col-xs-12 col-sm-12 ">
                        <div class="fw-pricing clearfix row">
                                    @foreach (var item in Model.MasterPlans)
                                    {
                                        if (item.IsSuggested == false)
                                        {
                                            <div class="fw-package-wrap col-md-6">
                                                <div class="fw-package">
                                                    <div class="fw-heading-row">
                                                        <span>@item.Name</span>
                                                    </div>
                                                    <div class="fw-pricing-row">
                                                        <span>@item.Price</span>
                                                        <small>@item.PricePeriod</small>
                                                    </div>
                                                    <div class="fw-button-row">
                                                        <a href="#" target="_self" class="btn btn-secondary">Free Trial</a>
                                                    </div>
                                                    @foreach (var content in Model.MasterPlanItems.Where(x => x.PlanId == 0))
                                                    {
                                                        <div class="fw-default-row">@content.Desc</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-package-wrap col-md-6 highlight-col ">
                                                <div class="fw-package">
                                                    <div class="fw-heading-row">
                                                        <span>@item.Name</span>
                                                    </div>
                                                    <div class="fw-pricing-row">
                                                        <span>@item.Price</span>
                                                        <small>@item.PricePeriod</small>
                                                    </div>
                                                    <div class="fw-button-row">
                                                        <a href="#" target="_self" class="btn btn-primary">Free Trial</a>
                                                    </div>                            
                                                    @foreach (var content in Model.MasterPlanItems.Where(x => x.PlanId != 0))
                                                    {
                                                        <div class="fw-default-row">@content.Desc</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                        </div>
                    </div>
                </div>
                <!-- End of Pricing -->

                <div class="white-space-50"></div>

                <!-- Fun Facts -->
                <div class="row">
                    <div class="col-xs-12 col-sm-12">

                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "FunFacts")?.Title)</h3>
                        </div>
                    </div>
                </div>
                        @foreach (var item in Model.MasterFacts)
                        {
                            <div class="row">
                                <div class="col-xs-12 col-sm-4">
                                    <div class="fun-fact gray-default">
                                        <i class="@item.Icon"></i>
                                        <h4>@item.Title</h4>
                                        <span class="fun-fact-block-value">@item.Number</span>
                                        <span class="fun-fact-block-text"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        
                <!-- End of Fun Facts -->

            </div>
        </section>
        <!-- End of About Me Subpage -->
        <!-- Resume Subpage -->
        <section data-id="resume" class="animated-section">
            <div class="page-title">
                        <h2>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Resume")?.Title)</h2>
            </div>

            <div class="section-content">

                <div class="row">
                    <div class="col-xs-12 col-sm-7">

                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Education")?.Title)</h3>
                        </div>
                      
                        <div class="timeline timeline-second-style clearfix">
                                    @foreach (var item in Model.MasterEducation)
                                    {
                                        <div class="timeline-item clearfix">
                                            <div class="left-part">
                                                <h5 class="item-period">@item.Year</h5>
                                                <span class="item-company">@item.University</span>
                                            </div>
                                            <div class="divider"></div>
                                            <div class="right-part">
                                                <h4 class="item-title">@item.Title</h4>
                                                <p>@item.Desc</p>
                                            </div>
                                        </div>
                                    }
                        </div>

                        <div class="white-space-50"></div>

                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Experience")?.Title)</h3>
                        </div>

                        <div class="timeline timeline-second-style clearfix">
                                    @foreach (var item in Model.MasterExperience)
                                    {
                                        <div class="timeline-item clearfix">
                                            <div class="left-part">
                                                <h5 class="item-period">@item.StartYear - @item.EndYear</h5>
                                                <span class="item-company">@item.CompanyName</span>
                                            </div>
                                            <div class="divider"></div>
                                            <div class="right-part">
                                                <h4 class="item-title">@item.Title</h4>
                                                <p>@item.Desc</p>
                                            </div>
                                        </div>
                                    }
                        </div>

                    </div>

                    <!-- Skills & Certificates -->
                    <div class="col-xs-12 col-sm-5">
                        <!-- Design Skills -->
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "DesignSkills")?.Title)</h3>
                        </div>

                        <div class="skills-info skills-second-style">
                                    @foreach (var item in Model.MasterSkills.Where(x => !x.IsSoftSkill && !x.IsKnowledge))
                                    {
                                        <!-- Skill 1 -->
                                        <div class="skill clearfix">
                                            <h4>@item.Name</h4>
                                            <div class="skill-value">@item.Percentage%</div>
                                        </div>
                                        <div class="skill-container skill-1">
                                            <div class="skill-percentage" style="width: @(item.Percentage)%;"></div>
                                        </div>
                                        <!-- End of Skill 1 -->
                                    }
                        </div>
                        <!-- End of Design Skills -->

                        <div class="white-space-10"></div>

                        <!-- Coding Skills -->
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "CodingSkills")?.Title)</h3>
                        </div>

                        <div class="skills-info skills-second-style">
                                    @foreach (var item in Model.MasterSkills.Where(x =>x.IsSoftSkill && !x.IsKnowledge))
                                    {
                                        <!-- Skill 5 -->
                                        <div class="skill clearfix">
                                            <h4>@item.Name</h4>
                                            <div class="skill-value">@item.Percentage%</div>
                                        </div>
                                        <div class="skill-container skill-1">
                                            <div class="skill-percentage" style="width: @(item.Percentage)%;"></div>
                                        </div>
                                        <!-- End of Skill 5 -->
                                    }
                        </div>
                        <!-- End of Coding Skills -->

                        <div class="white-space-10"></div>

                        <!-- Knowledges -->
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Knowledges")?.Title)</h3>
                        </div>

                        <ul class="knowledges">
                                    @foreach (var item in Model.MasterSkills.Where(x => !x.IsSoftSkill && x.IsKnowledge))
                                    {
                                        <li>@item.Name</li>
                                    }
                        </ul>
                        <!-- End of Knowledges -->
                    </div>
                    <!-- End of Skills & Certificates -->
                </div>

                <div class="white-space-50"></div>

                <!-- Certificates -->
                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="block-title">
                                    <h3>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Certificates")?.Title)</h3>
                        </div>
                    </div>
                </div>
                <div class="row">
                            @foreach (var item in Model.MasterCertificates)
                            {
                                <!-- Certificate 1 -->
                                <div class="col-xs-12 col-sm-6">
                                    <div class="certificate-item clearfix">
                                        <div class="certi-logo">
                                            <img src="@item.ImageURL" alt="logo">
                                        </div>
                        
                                        <div class="certi-content">
                                            <div class="certi-title">
                                                <h4>@item.Title</h4>
                                            </div>
                                            <div class="certi-id">
                                                <span>Membership ID: @item.MembershipId</span>
                                            </div>
                                            <div class="certi-date">
                                                <span>@item.Date</span>
                                            </div>
                                            <div class="certi-company">
                                                <span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- End of Certificate 1 -->
                            }
                </div>
                <!-- End of Certificates -->
            </div>
        </section>
        <!-- End of Resume Subpage -->
        <!-- Portfolio Subpage -->
        <section data-id="portfolio" class="animated-section">
            <div class="page-title">
                        <h2>@Html.Raw(Model.MasterTitles.FirstOrDefault(x => x.Keyword == "Portfolio")?.Title)</h2>
            </div>

            <div class="section-content">

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                                <div class="portfolio-content">

                                    
                                    <ul class="portfolio-filters">
                                        <li class="active">
                                            <a class="filter btn btn-sm btn-link" data-group="all">All</a>
                                        </li>
                                        @foreach (var category in Model.MasterCategory.Where(x => x.Name != "All"))
                                        {
                                            <li>
                                                <a class="filter btn btn-sm btn-link" data-group="category_@category.Id">@category.Name</a>
                                            </li>
                                        }
                                    </ul>

                                    
                                    <div class="portfolio-grid three-columns">
                                        @foreach (var item in Model.MasterPortfolio)
                                        {
                                            <figure class="item lbimage" data-groups='["all", "category_@item.CategoryId"]'>
                                                <div class="portfolio-item-img">
                                                    <img src="@item.ThumbnailImageURL" alt="@item.Title" title="" />
                                                    <a class="lightbox" title="@item.Title" href="@item.ViewImageURL"></a>
                                                </div>

                                                <i class="far fa-image"></i>
                                                <h4 class="name">@item.Title</h4>
                                                <span class="category">@item.Title</span>
                                            </figure>
                                        }
                                    </div>
                                </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Contact Subpage -->
        <section data-id="contact" class="animated-section">
            <div class="page-title">
                <h2>Contact</h2>
            </div>

            <div class="section-content">

                <div class="row">
                            <!-- Contact Info -->
                    <div class="col-xs-12 col-sm-4">
                                @foreach (var item in Model.MasterContactUs)
                                {
                                    <div class="lm-info-block gray-default">
                                        <i class="@item.Icon"></i>
                                       <a href="@item.Link" target="_blank" rel="noopener noreferrer"><h4>@item.Title</h4></a>
                                        <span class="lm-info-block-value"></span>
                                        <span class="lm-info-block-text"></span>
                                    </div>
                                }
                    </div>
                    <!-- End of Contact Info -->
                    <!-- Contact Form -->
                    <div class="col-xs-12 col-sm-8">
                        <div class="block-title">
                            <h3>How Can I <span>Help You?</span></h3>
                        </div>

                        <form asp-controller="Home" asp-action="SendContactMessage" method="post">

                            <div class="messages"></div>

                            <div class="controls two-columns">
                                <div class="fields clearfix">
                                    <div class="left-column">
                                        <div class="form-group form-group-with-icon">
                                                    <input type="text" name="FullName" class="form-control" required />
                                            <label>Full Name</label>
                                            <div class="form-control-border"></div>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group form-group-with-icon">
                                                    <input type="email" name="Email" class="form-control"  required />
                                            <label>Email Address</label>
                                            <div class="form-control-border"></div>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group form-group-with-icon">
                                                    <input type="text" name="Subject" class="form-control"  required />
                                            <label>Subject</label>
                                            <div class="form-control-border"></div>
                                            <div class="help-block with-errors"></div>
                                        </div>
                                    </div>
                                    <div class="right-column">
                                        <div class="form-group form-group-with-icon">
                                            <textarea id="form_message" name="Message" class="form-control" placeholder="" rows="7" required="required" data-error="Please, leave me a message."></textarea>
                                            <label>Message</label>
                                            <div class="form-control-border"></div>
                                            <div class="help-block with-errors"></div>
                                        </div>
                                    </div>
                                </div>

      
                                <input type="submit" class="button btn-send" value="Send message">
                            </div>
                        </form>
                    </div>
                    <!-- End of Contact Form -->
                </div>

            </div>
        </section>
        <!-- End of Contact Subpage -->
    </div>
</div>

</div>
</div>